# ==============================================================================
# Miller SaaS Hub — Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development.
# Configure corresponding variables in your production host (e.g., Vercel / Railway).
# ==============================================================================

# ── SUPABASE (Database, Auth, & Storage) ─────────────────────────────────────
# Client-side variables (exposed to browser for Supabase Auth & Public Queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only variable (REQUIRED in production for webhook ingestion to bypass RLS)
# DO NOT prefix with NEXT_PUBLIC_. Keep strictly private on server / Vercel secrets.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── STRIPE (Billing & Subscription Metering) ──────────────────────────────────
# Public key used for frontend Stripe Elements (if needed)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret key used server-side in /api/billing/checkout
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── META WHATSAPP BUSINESS WEBHOOK ───────────────────────────────────────────
# Verification token configured in Meta Developer Portal Webhooks
WHATSAPP_VERIFY_TOKEN=miller_saas_hub_webhook_secret
WHATSAPP_API_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=100...

# ── EMAIL DISPATCHER (Resend / SendGrid) ──────────────────────────────────────
# Resend API key for automated Miller AI lead nurture HTML emails
RESEND_API_KEY=re_...
# Alternative: SendGrid API key
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL="Miller AI <notifications@yourdomain.com>"

# ── AI & EXTERNAL INTEGRATIONS ────────────────────────────────────────────────
# JigsawStack AI Vision & Scraper Key
JIGSAWSTACK_KEY=sk_...

# E-commerce Connectors (Optional per merchant)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
